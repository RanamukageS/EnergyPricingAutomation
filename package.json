{
  "name": "origin-automation-test",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation tests for Origin Energy website",
  "scripts": {
    "test": "rm -rf allure-results/* && playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "install:browsers": "playwright install --with-deps chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.11",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "dotenv": "^17.3.1",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  }
}
